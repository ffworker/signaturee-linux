# Copy to .env; DO NOT COMMIT .env. Use ONLY a disposable test AD.
# Set to true ONLY for a disposable isolated lab using ldap://:389; password travels in cleartext.
SIGNATUREE_ALLOW_INSECURE_LAB_LDAP=false
SIGNATUREE_LDAP_URL=ldaps://dc-test.example.invalid:636
SIGNATUREE_LDAP_BASE_DN=DC=example,DC=invalid
SIGNATUREE_LDAP_BIND_DN=CN=signaturee-reader,OU=Service,DC=example,DC=invalid
# Test-only convenience: Docker environment variables are visible through docker inspect.
# Never use a privileged account or production credentials in this mode.
SIGNATUREE_LDAP_BIND_PASSWORD=REPLACE_WITH_TEST_ONLY_PASSWORD
# If your LDAPS server uses a private CA, put its PEM under dev/templates.
SIGNATUREE_LDAP_CA_FILE=
# These are JSON arrays; keep outer single quotes for Compose .env parsing.
SIGNATUREE_ALLOWED_TEST_ACCOUNTS_JSON='["test.user"]'
SIGNATUREE_PROFILES_JSON='[{"key":"HR","encoding":"utf-8","images":[]}]'
SIGNATUREE_MAPPINGS_JSON='[{"groupDn":"CN=Signature-HR,OU=Groups,DC=example,DC=invalid","signatureKey":"HR"}]'
SIGNATUREE_STATIC_VALUES_JSON='{}'
